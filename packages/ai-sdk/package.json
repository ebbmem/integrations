{
  "name": "@ebbmem/ai-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Vercel AI SDK tools and language-model middleware for EbbMem cognitive memory (IC-1).",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build/test/test/*.test.js"
  },
  "dependencies": {
    "ebbmem-integration-core": "file:../typescript"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@types/node": "^22.0.0",
    "ai": "^7.0.179",
    "typescript": "^5.0.0",
    "zod": "^4.3.6"
  }
}
