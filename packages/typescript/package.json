{
  "name": "ebbmem-integration-core",
  "version": "0.1.0",
  "description": "Core integration primitives, scoping, security, resilience, and reinforcement tracking for EbbMem (IC-1).",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build/test/test/*.test.js",
    "test:unit": "tsc -p tsconfig.test.json && node --test build/test/test/unit.test.js",
    "test:conformance": "tsc -p tsconfig.test.json && node --test build/test/test/conformance.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
